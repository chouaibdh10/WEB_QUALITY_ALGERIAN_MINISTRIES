{
  "name": "algerian-ministries-web-quality-index",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy && wrangler versions upload --preview-alias refined && npm run verify:deployment",
    "measure": "node scripts/measure.mjs",
    "test:measurement": "node --test scripts/quality/*.test.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "axe-core": "4.14.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "13.5.0",
    "postcss": "^8.5.28",
    "puppeteer-core": "25.14.0",
    "robots-parser": "3.0.1",
    "run-parallel": "^1.2.0",
    "tailwindcss": "^3.4.17",
    "wrangler": "4.151.0"
  }
}
