{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "algerian-ministries-web-quality",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker.js",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
